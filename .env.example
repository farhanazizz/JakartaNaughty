# ============================================================
# .env.example — Template environment variables
# COPY file ini menjadi .env dan isi semua nilainya
# JANGAN commit file .env ke git!
# ============================================================

# --- SERVER ---
PORT=3000
NODE_ENV=development   # 'development' atau 'production'

# --- JWT (JSON Web Token) ---
# Ganti dengan string random panjang (min 32 karakter)
JWT_SECRET=ganti-dengan-string-random-yang-panjang-sekali
JWT_REFRESH_SECRET=ganti-dengan-string-random-lain-yang-berbeda
JWT_ACCESS_EXPIRE=15m   # Access token expire: 15 menit
JWT_REFRESH_EXPIRE=7d   # Refresh token expire: 7 hari

# --- SESSION (untuk Google OAuth) ---
SESSION_SECRET=ganti-dengan-string-random-untuk-session

# --- GOOGLE OAUTH (untuk admin login) ---
# Dapatkan dari https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/admin/callback

# --- ADMIN (daftar email yang boleh login sebagai admin) ---
# Pisahkan dengan koma jika lebih dari satu
ADMIN_EMAILS=youremail@gmail.com

# --- VAST.AI ---
# Dapatkan dari https://cloud.vast.ai/account/
VASTAI_API_KEY=your-vastai-api-key

# --- COMFYUI ---
# Port ComfyUI di setiap GPU instance
COMFYUI_PORT=18188
# Path workflow di GPU server
COMFYUI_WORKFLOW_PATH=/workspace/ComfyUI/user/default/workflows/Krea 2 + Edit Lora - kapake.json

# --- JOB QUEUE ---
# Maksimal job pending+processing per user sekaligus
MAX_CONCURRENT_JOBS_PER_USER=3
# Seberapa sering (detik) backend refresh cache daftar GPU dari Vast.ai
GPU_CACHE_TTL_SECONDS=30
# Timeout job dalam menit (job otomatis failed jika melebihi ini)
JOB_TIMEOUT_MINUTES=10

# --- UPLOAD ---
# Ukuran maksimal file upload dalam MB
UPLOAD_MAX_SIZE_MB=10

# --- CLOUDFLARE R2 STORAGE ---
# S3-compatible Object Storage untuk gambar hasil generate
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=jakartanaughty
R2_PUBLIC_DOMAIN=https://pub-d347c89dddda4d359aaf6b53808fc497.r2.dev

